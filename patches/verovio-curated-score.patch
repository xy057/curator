+// [curated-score patch] A text's face (0 as written, 1 regular, 2 italic, 3 bold, 4 bold italic) and
+// letter spacing (ems) from the app's typography.
+static void CuratedLook(FontInfo &font, int face, double tracking)
+{
+    if (face > 0) {
+        font.SetStyle(((face == 2) || (face == 4)) ? FONTSTYLE_italic : FONTSTYLE_normal);
+        font.SetWeight((face >= 3) ? FONTWEIGHT_bold : FONTWEIGHT_normal);
+    }
+    if (tracking != 0.0) font.SetLetterSpacing(tracking * font.GetPointSize());
+}
