+// [curated-score patch] The size noteheads (SMuFL's noteheads range) are drawn and measured at, so
+// stems, dots, ledger lines and accidentals keep to them; any other glyph's is the staff's.
+inline int CuratedGlyphSize(char32_t code, int staffSize, const Options &options)
+{
+    return ((code >= 0xE0A0) && (code <= 0xE0FF)) ? CuratedSize(staffSize, options.m_curatedNoteheadScale) : staffSize;
