+// [curated-score patch] The app's typography (Project Settings ▸ Typography) on the element it
+// changes: a size as a share of the text's own, and letter spacing in MEI's virtual units. Its own
+// attributes, so a file's font-size (in points, which Verovio ignores) still changes nothing.
+static void CuratedTypography(pugi::xml_node node, AttTypography *typography)
+{
+    if (pugi::xml_attribute size = node.attribute("curated-score-size")) {
+        data_FONTSIZE fontSize;
+        fontSize.SetPercent(size.as_double());
+        typography->SetFontsize(fontSize);
+    }
+    if (pugi::xml_attribute tracking = node.attribute("curated-score-tracking")) {
+        typography->SetLetterspacing(tracking.as_double());
+    }
+}
