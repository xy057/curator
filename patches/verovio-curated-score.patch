+            int local = 0;
+            for (Object *child : measure->GetChildren()) {
+                if (!child->Is(STAFF)) continue;
+                ++local;
+                if (keyStaff > 0 && keyStaff != local) continue;
+                StaffDef *staffDef = new StaffDef();
+                staffDef->SetN(vrv_cast<Staff *>(child)->GetN());
+                staffDef->AddChild(ConvertKey(partKey));
+                staffGrp->AddChild(staffDef);
+            }
+        }
+    }
