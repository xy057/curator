+        // The scoreDef right before this measure: the part's measures merge into the first part's.
+        ScoreDef *scoreDef = NULL;
+        for (Object *child : section->GetChildren()) {
+            if (!child->Is(MEASURE) || m_measureCounts.at(vrv_cast<Measure *>(child)) != measureIndex) continue;
+            const int index = section->GetChildIndex(child);
+            Object *previous = (index > 0) ? section->GetChild(index - 1) : NULL;
+            if (previous && previous->Is(SCOREDEF)) {
+                scoreDef = vrv_cast<ScoreDef *>(previous);
+            }
+            else {
+                scoreDef = new ScoreDef();
+                section->InsertBefore(child, scoreDef);
+            }
+            break;
+        }
+        if (!scoreDef) scoreDef = GetOrCreateLastScoreDef(section); // first part: measure not added yet
+
+        StaffGrp *staffGrp = vrv_cast<StaffGrp *>(scoreDef->FindDescendantByType(STAFFGRP, 1));
+        if (!staffGrp) {
+            staffGrp = new StaffGrp();
+            scoreDef->AddChild(staffGrp);
+        }
+        for (pugi::xml_node partKey : node.children("key")) {
