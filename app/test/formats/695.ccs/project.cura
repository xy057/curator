module automation version 1 optional
  lanes
    view
      kind "steps"
      stretches
        -
          from 6.0
          to 12.0
          value
            kind "map"
        -
          from 12.0
          to 18.0
          value
            kind "split"
            side "bottom"
            size 0.3
          fade 0.0
        -
          from 18.0
          to 24.0
          value
            kind "map"
        -
          from 30.0
          to 36.0
          value
            kind "midi"

module view version 1 optional
  staffSpace 11.0
  grid "beat"
  snapTapsToOnsets false
  time 12.5

module script version 1 optional
  text
    | # The strings open; the winds come in at B.
    | let winds = "Flute*", "Oboe*", "Clarinet in B♭"
    | clear
    | show "Violin I", "Violin II", "Viola" 1-16
    |

module harmony version 3 optional
  keys [1, 2.0, -0.5]
  text
    | two
    |   lines
    |
  quoted "a \"b\" \\ c\td"
