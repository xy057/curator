# Written by Curator, in CuraScript: what the file is, then each of its modules.
format "application/x-curated-score"
layout 3
writer "Curator 0.11.0-beta1 (695)"
kind "score"
score
  name "Score.musicxml"
  entry "score/Score.musicxml"
media
  name "Concert.wav"
  entry "media/Concert.wav"
takes
  -
    id "take-2"
    name "Rehearsal.wav"
    entry "media/takes/take-2/Rehearsal.wav"
stems
  -
    id "stem-1"
    name "Strings.wav"
    entry "media/stems/stem-1/Strings.wav"

module pdf version 2
